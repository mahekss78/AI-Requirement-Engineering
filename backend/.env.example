# AREA Platform Environment Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL Database (Defaults to SQLite in-memory for tests if unconfigured)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/area_db

# OpenAI API Key (REQUIRED for Real LLM Execution)
OPENAI_API_KEY=sk-proj-YOUR_ACTUAL_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# ChromaDB & Local RAG Embeddings
CHROMA_DB_PATH=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional Jira Credentials (Stub 501 for current phase)
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=XYZ

# Optional SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
